{
  "name": "googletrans",
  "version": "1.0.29",
  "description": "Free and Unlimited Google Translate API for Node.js and Bun",
  "files": [
    "lib"
  ],
  "main": "./lib/googletrans.js",
  "module": "./lib/googletrans.mjs",
  "types": "./lib/googletrans.d.ts",
  "type": "commonjs",
  "engines": {
    "node": ">=16"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./lib/googletrans.d.mts",
        "default": "./lib/googletrans.mjs"
      },
      "require": {
        "types": "./lib/googletrans.d.ts",
        "default": "./lib/googletrans.js"
      },
      "default": "./lib/googletrans.js"
    },
    "./lib/googletrans": {
      "import": {
        "types": "./lib/googletrans.d.mts",
        "default": "./lib/googletrans.mjs"
      },
      "require": {
        "types": "./lib/googletrans.d.ts",
        "default": "./lib/googletrans.js"
      },
      "default": "./lib/googletrans.js"
    },
    "./lib/googletrans.js": {
      "import": {
        "types": "./lib/googletrans.d.mts",
        "default": "./lib/googletrans.mjs"
      },
      "require": {
        "types": "./lib/googletrans.d.ts",
        "default": "./lib/googletrans.js"
      },
      "default": "./lib/googletrans.js"
    },
    "./lib/googleToken": {
      "import": {
        "types": "./lib/googleToken.d.mts",
        "default": "./lib/googleToken.mjs"
      },
      "require": {
        "types": "./lib/googleToken.d.ts",
        "default": "./lib/googleToken.js"
      },
      "default": "./lib/googleToken.js"
    },
    "./lib/googleToken.js": {
      "import": {
        "types": "./lib/googleToken.d.mts",
        "default": "./lib/googleToken.mjs"
      },
      "require": {
        "types": "./lib/googleToken.d.ts",
        "default": "./lib/googleToken.js"
      },
      "default": "./lib/googleToken.js"
    },
    "./lib/languages": {
      "import": {
        "types": "./lib/languages.d.mts",
        "default": "./lib/languages.mjs"
      },
      "require": {
        "types": "./lib/languages.d.ts",
        "default": "./lib/languages.js"
      },
      "default": "./lib/languages.js"
    },
    "./lib/languages.js": {
      "import": {
        "types": "./lib/languages.d.mts",
        "default": "./lib/languages.mjs"
      },
      "require": {
        "types": "./lib/languages.d.ts",
        "default": "./lib/languages.js"
      },
      "default": "./lib/languages.js"
    },
    "./lib/userAgents": {
      "import": {
        "types": "./lib/userAgents.d.mts",
        "default": "./lib/userAgents.mjs"
      },
      "require": {
        "types": "./lib/userAgents.d.ts",
        "default": "./lib/userAgents.js"
      },
      "default": "./lib/userAgents.js"
    },
    "./lib/userAgents.js": {
      "import": {
        "types": "./lib/userAgents.d.mts",
        "default": "./lib/userAgents.mjs"
      },
      "require": {
        "types": "./lib/userAgents.d.ts",
        "default": "./lib/userAgents.js"
      },
      "default": "./lib/userAgents.js"
    },
    "./lib/utils": {
      "import": {
        "types": "./lib/utils.d.mts",
        "default": "./lib/utils.mjs"
      },
      "require": {
        "types": "./lib/utils.d.ts",
        "default": "./lib/utils.js"
      },
      "default": "./lib/utils.js"
    },
    "./lib/utils.js": {
      "import": {
        "types": "./lib/utils.d.mts",
        "default": "./lib/utils.mjs"
      },
      "require": {
        "types": "./lib/utils.d.ts",
        "default": "./lib/utils.js"
      },
      "default": "./lib/utils.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "jest --config jestconfig.json --coverage",
    "test:integration": "jest --config jestconfig.integration.json --runInBand",
    "test:package": "npm run build && node scripts/test-package.js",
    "test:package:live": "npm run build && node scripts/test-package.js --live",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsdown",
    "commit": "npx git-cz",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarinRowe/googletrans.git"
  },
  "keywords": [
    "google",
    "language",
    "i18n",
    "localization",
    "googletranslate",
    "translation",
    "translator",
    "translate",
    "node",
    "google translator",
    "googlet ranslate"
  ],
  "author": "Darin Lo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DarinRowe/googletrans/issues"
  },
  "homepage": "https://github.com/DarinRowe/googletrans#readme",
  "dependencies": {
    "axios": "^1.18.1",
    "qs": "^6.15.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.0",
    "@types/qs": "^6.15.1",
    "jest": "^30.4.2",
    "publint": "^0.3.22",
    "ts-jest": "^29.4.12",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  }
}
